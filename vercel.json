{
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.go": {
      "runtime": "go1.x"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?route=:path*" },
    { "source": "/healthz", "destination": "/api?route=healthz" }
  ]
}
